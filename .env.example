# ===== LangGraph Demo 环境变量模板 =====
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）

# 兼容 OpenAI 格式的 API 地址（chat/completions）
BASE_URL=https://tokenrhythm.studio/v1

# API Key
API_KEY=sk_tr_xxx

# 模型名 —— 必须填网关「支持」的模型！
# 运行 `npm run models` 可查看网关支持的完整列表（deepseek-v4-flash 实测可用）
MODEL=deepseek-v4-flash
